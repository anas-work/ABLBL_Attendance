<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>AI Monk Attendance Monitoring</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- Client-Side Face Detection Engines (ONNX Runtime Web for SCRFD & MediaPipe Fallback) -->
    <script src="https://cdn.jsdelivr.net/npm/onnxruntime-web@1.17.3/dist/ort.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_detection/face_detection.js" crossorigin="anonymous"></script>
    <style>
        :root {
            --bg-body: #09090b;
            --bg-card: #121215;
            --bg-card-hover: #18181c;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-highlight: rgba(255, 255, 255, 0.16);
            --text-primary: #f4f4f5;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;

            --accent-green: #10b981;
            --accent-orange: #f97316;
            --accent-purple: #a855f7;
            --accent-blue: #3b82f6;
            --accent-cyan: #06b6d4;
            --accent-red: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-primary);
            min-height: 100vh;
            min-height: -webkit-fill-available;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navigation Header Bar */
        header {
            background: rgba(9, 9, 11, 0.88);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-subtle);
            padding: 14px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
            gap: 14px;
            flex-wrap: wrap;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
            flex-shrink: 0;
        }

        .brand-title {
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-primary);
            white-space: nowrap;
        }

        .header-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* Enroll Employee Button */
        .enroll-btn {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(6, 182, 212, 0.18) 100%);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
            white-space: nowrap;
        }

        .enroll-btn:hover {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.32) 0%, rgba(6, 182, 212, 0.32) 100%);
            color: #fff;
            border-color: rgba(16, 185, 129, 0.6);
            box-shadow: 0 0 14px rgba(16, 185, 129, 0.25);
            transform: translateY(-1px);
        }

        /* Directory Action Button */
        .dir-btn {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.18) 0%, rgba(168, 85, 247, 0.18) 100%);
            border: 1px solid rgba(59, 130, 246, 0.35);
            color: #60a5fa;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
            white-space: nowrap;
        }

        .dir-btn:hover {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.32) 0%, rgba(168, 85, 247, 0.32) 100%);
            color: #fff;
            border-color: rgba(59, 130, 246, 0.6);
            box-shadow: 0 0 14px rgba(59, 130, 246, 0.25);
            transform: translateY(-1px);
        }

        .delete-btn {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #f87171;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.74rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .delete-btn:hover {
            background: rgba(239, 68, 68, 0.25);
            border-color: rgba(239, 68, 68, 0.6);
            color: #fff;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
            transform: translateY(-1px);
        }

        .dir-employee-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }

        .dir-employee-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--border-highlight);
        }

        /* Segmented Controls */
        .segmented-control {
            display: flex;
            background: rgba(255, 255, 255, 0.04);
            padding: 3px;
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            -webkit-user-select: none;
            user-select: none;
        }

        .control-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
        }

        .control-btn:hover {
            color: #fff;
        }

        .control-btn.active-live {
            background: rgba(6, 182, 212, 0.18);
            color: var(--accent-cyan);
            border: 1px solid rgba(6, 182, 212, 0.35);
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);
        }

        .control-btn.active-feed {
            background: rgba(59, 130, 246, 0.18);
            color: var(--accent-blue);
            border: 1px solid rgba(59, 130, 246, 0.35);
        }

        .control-btn.active-entry {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .control-btn.active-exit {
            background: rgba(168, 85, 247, 0.15);
            color: var(--accent-purple);
            border: 1px solid rgba(168, 85, 247, 0.3);
        }

        /* Dashboard Grid Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 2.2fr 1fr;
            gap: 24px;
            padding: 24px 32px;
            flex: 1;
            max-width: 1720px;
            margin: 0 auto;
            width: 100%;
        }

        /* Stream Viewport */
        .stream-panel {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 18px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
            gap: 10px;
            height: fit-content;
        }

        .stream-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 6px;
            min-height: 36px;
        }

        .stream-status-tag {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-secondary);
            letter-spacing: 0.02em;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent-cyan);
            box-shadow: 0 0 10px var(--accent-cyan);
            animation: pulse 1.8s infinite;
        }

        .pulse-dot.dot-feed {
            background: var(--accent-blue);
            box-shadow: 0 0 10px var(--accent-blue);
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                opacity: 0.7;
            }

            50% {
                transform: scale(1.2);
                opacity: 1;
            }

            100% {
                transform: scale(0.95);
                opacity: 0.7;
            }
        }

        .stream-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .action-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 6px 14px;
            border-radius: 10px;
            font-size: 0.74rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            border-color: var(--border-highlight);
        }

        .stream-viewport {
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            background: #000;
            aspect-ratio: 16 / 9;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
        }

        .stream-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        /* Camera Start Overlay */
        .camera-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(18, 18, 21, 0.96) 0%, rgba(9, 9, 11, 0.98) 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
            text-align: center;
            z-index: 20;
            transition: opacity 0.3s ease;
        }

        .camera-overlay.hidden {
            display: none;
        }

        .cam-icon-circle {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: rgba(6, 182, 212, 0.12);
            border: 1px solid rgba(6, 182, 212, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 16px;
            box-shadow: 0 0 28px rgba(6, 182, 212, 0.25);
        }

        .cam-overlay-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
            letter-spacing: -0.01em;
        }

        .cam-overlay-subtitle {
            font-size: 0.84rem;
            color: var(--text-muted);
            max-width: 440px;
            line-height: 1.5;
            margin-bottom: 22px;
        }

        .cam-buttons-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
            max-width: 420px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
            color: #fff;
            border: none;
            padding: 12px 26px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 18px rgba(6, 182, 212, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex: 1;
            min-width: 180px;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 24px rgba(6, 182, 212, 0.55);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-secondary);
            border: 1px solid var(--border-subtle);
            padding: 12px 20px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex: 1;
            min-width: 180px;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            border-color: var(--border-highlight);
        }

        .cam-error-box {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 10px;
            padding: 12px 18px;
            color: #fca5a5;
            font-size: 0.8rem;
            max-width: 480px;
            line-height: 1.4;
            margin-top: 16px;
            text-align: left;
        }

        /* Sidebar Column */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Metrics Row */
        .metrics-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .metric-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 14px 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .metric-title {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .metric-val {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.01em;
        }

        /* Activity Logs Section */
        .logs-panel {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 18px;
            padding: 18px;
            flex: 1;
            display: flex;
            flex-direction: column;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
            min-height: 400px;
        }

        .logs-header {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .logs-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logs-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .logs-hint {
            font-size: 0.72rem;
            color: var(--text-muted);
        }

        .tab-bar {
            display: flex;
            background: rgba(255, 255, 255, 0.03);
            padding: 3px;
            border-radius: 10px;
            border: 1px solid var(--border-subtle);
            -webkit-user-select: none;
            user-select: none;
        }

        .tab-item {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 8px 0;
            font-size: 0.74rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            text-align: center;
            transition: all 0.2s ease;
        }

        .tab-item.active-checkin {
            background: rgba(16, 185, 129, 0.14);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .tab-item.active-checkout {
            background: rgba(168, 85, 247, 0.14);
            color: var(--accent-purple);
            border: 1px solid rgba(168, 85, 247, 0.3);
        }

        .tab-item.active-all {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-primary);
        }

        /* Activity List */
        .activity-list {
            list-style: none;
            overflow-y: auto;
            max-height: 520px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            -webkit-overflow-scrolling: touch;
        }

        .activity-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-subtle);
            padding: 14px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .activity-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: var(--border-highlight);
            transform: translateY(-1px);
        }

        .activity-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .emp-name {
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: -0.01em;
        }

        .sub-btn-group {
            display: flex;
            gap: 4px;
            align-items: center;
        }

        .pill-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            color: var(--text-muted);
            padding: 4px 9px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .pill-btn.active-checkin {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border-color: rgba(16, 185, 129, 0.3);
        }

        .pill-btn.active-reentry {
            background: rgba(249, 115, 22, 0.15);
            color: var(--accent-orange);
            border-color: rgba(249, 115, 22, 0.3);
        }

        .pill-btn.active-checkout {
            background: rgba(168, 85, 247, 0.15);
            color: var(--accent-purple);
            border-color: rgba(168, 85, 247, 0.3);
        }

        .badge-tag {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 12px;
            border: 1px solid transparent;
        }

        .dual-photos {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 8px;
        }

        .photo-box {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .photo-box img {
            width: 100%;
            height: 100px;
            object-fit: contain;
            border-radius: 8px;
            background: #000;
        }

        .photo-caption {
            font-size: 0.64rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            text-align: center;
        }

        .empty-state {
            color: var(--text-muted);
            text-align: center;
            padding: 32px 16px;
            font-size: 0.85rem;
            font-style: italic;
        }

        /* Modal Lightbox Overlay */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
            padding: 16px;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            background: #121215;
            border: 1px solid var(--border-subtle);
            box-shadow: 0 24px 48px rgba(0, 0, 0, 0.8);
            border-radius: 18px;
            padding: 22px;
            width: 100%;
            max-width: 820px;
            max-height: 92vh;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            transform: scale(0.95);
            transition: transform 0.25s ease;
            -webkit-overflow-scrolling: touch;
        }

        .modal-overlay.active .modal-card {
            transform: scale(1);
        }

        .modal-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 10px;
        }

        .modal-heading {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.8rem;
            cursor: pointer;
            line-height: 1;
            padding: 8px 12px;
        }

        .modal-photos-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 14px;
        }

        .modal-photo-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .modal-photo-item img {
            width: 100%;
            height: 290px;
            object-fit: contain;
            border-radius: 10px;
            background: #000;
        }

        .modal-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.02);
            padding: 12px 16px;
            border-radius: 10px;
            border: 1px solid var(--border-subtle);
            font-size: 0.84rem;
        }

        /* Enrollment Dropzone & Form */
        .enroll-dropzone {
            border: 2px dashed rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.02);
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 140px;
        }

        .enroll-dropzone:hover,
        .enroll-dropzone.dragover {
            border-color: var(--accent-green);
            background: rgba(16, 185, 129, 0.05);
        }

        .enroll-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 10px 14px;
            color: #fff;
            font-size: 0.88rem;
            font-weight: 500;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .enroll-input:focus {
            border-color: var(--accent-green);
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .enroll-input::placeholder {
            color: var(--text-muted);
        }

        /* ---------------------------------------------------- */
        /* RESPONSIVE MEDIA QUERIES (Mobile & Tablet Adaptive)  */
        /* ---------------------------------------------------- */

        @media (max-width: 1080px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
                gap: 20px;
                padding: 18px 20px;
            }

            .activity-list {
                max-height: 480px;
            }
        }

        @media (max-width: 768px) {
            header {
                padding: 12px 16px;
                gap: 10px;
            }

            .brand-title {
                font-size: 0.95rem;
            }

            .header-controls {
                width: 100%;
                justify-content: space-between;
                gap: 8px;
            }

            .control-btn,
            .enroll-btn {
                padding: 6px 10px;
                font-size: 0.72rem;
            }

            .dashboard-grid {
                padding: 12px;
                gap: 14px;
            }

            .stream-panel {
                padding: 10px;
                border-radius: 14px;
            }

            .stream-viewport {
                border-radius: 10px;
            }

            .metrics-row {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .logs-panel {
                padding: 14px;
                border-radius: 14px;
            }

            .activity-list {
                max-height: 400px;
            }

            .dual-photos {
                grid-template-columns: 1fr 1fr;
            }

            .photo-box img {
                height: 86px;
            }

            .modal-photos-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .modal-photo-item img {
                height: 200px;
            }

            .modal-footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 6px;
            }
        }

        @media (max-width: 480px) {
            .brand-title {
                font-size: 0.88rem;
            }

            .control-btn,
            .enroll-btn {
                padding: 5px 8px;
                font-size: 0.68rem;
                gap: 4px;
            }

            .cam-buttons-group {
                flex-direction: column;
            }

            .btn-primary,
            .btn-secondary {
                width: 100%;
                min-width: unset;
            }
        }
    </style>
</head>

<body>

    <!-- Header Bar -->
    <header>
        <div class="brand-container">
            <div class="brand-logo"></div>
            <div class="brand-title">AI Monk Attendance</div>
        </div>

        <div class="header-controls">
            <!-- View Directory Action Button -->
            <button class="dir-btn" id="btn-open-dir" onclick="openDirectoryModal()"
                title="View & Manage Registered Employees">
                <span>👥</span> View Employees
            </button>

            <!-- Enroll Employee Action Button -->
            <button class="enroll-btn" id="btn-open-enroll" onclick="openEnrollModal()"
                title="Enroll New Employee Photo & Metadata">
                <span>➕</span> Enroll Employee
            </button>

            <!-- Video Source Selection: Live Camera vs Pre-recorded Feed -->
            <div class="segmented-control" title="Select Video Source">
                <button class="control-btn active-live" id="btn-source-live"
                    onclick="setVideoSourceMode('LIVE_CAMERA')">
                    <span>📷</span> LIVE CAMERA
                </button>
                <button class="control-btn" id="btn-source-feed" onclick="setVideoSourceMode('VIDEO_FEED')">
                    <span>📁</span> VIDEO FEED
                </button>
            </div>

            <!-- Operation Mode Selection: Entry vs Exit -->
            <div class="segmented-control" title="Operation Mode">
                <button class="control-btn active-entry" id="btn-mode-entry" onclick="switchSystemMode('ENTRY')">ENTRY
                    MODE</button>
                <button class="control-btn" id="btn-mode-exit" onclick="switchSystemMode('EXIT')">EXIT MODE</button>
            </div>
        </div>
    </header>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Live Video Viewport -->
        <div class="stream-panel">
            <div class="stream-toolbar">
                <div class="stream-status-tag" id="stream-status-display">
                    <div class="pulse-dot" id="stream-pulse-dot"></div>
                    <span id="stream-source-label">LIVE CAMERA (WEBCAM)</span>
                </div>

                <div class="stream-actions">
                    <button class="action-btn" id="btn-flip-cam" onclick="flipCameraFacingMode()"
                        title="Flip Front / Rear Camera" style="display: none;">
                        <span>🔄</span> Flip Cam
                    </button>
                    <button class="action-btn" id="btn-stop-cam" onclick="toggleCameraActive()"
                        title="Pause/Resume Camera" style="display: none;">
                        <span>⏹</span> Pause
                    </button>
                </div>
            </div>

            <div class="stream-viewport">
                <!-- Direct Hardware Accelerated Display Canvas for Client Live Camera (30-60 FPS) -->
                <canvas id="live-viewport-canvas" class="stream-img" style="display: none; background: #000; width: 100%; border-radius: 12px;"></canvas>

                <!-- Annotated Frame Display Image for Video Feed Mode -->
                <img id="stream-img" class="stream-img" alt="Stream Viewport"
                    src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='640' height='360' viewBox='0 0 640 360'><rect width='640' height='360' fill='%23000'/><text x='50%25' y='50%25' fill='%23666' font-family='sans-serif' font-size='14' text-anchor='middle'>Ready to start stream</text></svg>">

                <!-- Hidden video element for WebRTC camera stream -->
                <video id="webcam-video" playsinline muted autoplay style="display: none;"></video>
                <!-- Offscreen canvas for frame capture & crop extraction -->
                <canvas id="capture-canvas" style="display: none;"></canvas>
                <canvas id="crop-canvas" width="224" height="224" style="display: none;"></canvas>

                <!-- Camera Start Overlay -->
                <div class="camera-overlay" id="camera-overlay">
                    <div class="cam-icon-circle">📷</div>
                    <div class="cam-overlay-title" id="cam-overlay-title">Live Camera Capture</div>
                    <div class="cam-overlay-subtitle" id="cam-overlay-desc">
                        Click <strong>Start Live Capture</strong> to scan your face and monitor attendance in real time.
                    </div>

                    <div class="cam-buttons-group">
                        <button class="btn-primary" id="btn-open-camera" onclick="startLiveCapture()">
                            <span>🎥</span> Start Live Capture
                        </button>
                        <button class="btn-secondary" onclick="setVideoSourceMode('VIDEO_FEED')">
                            <span>📁</span> Use Video Feed (Live_Feed.mp4)
                        </button>
                    </div>

                    <div class="cam-error-box" id="cam-error-box" style="display: none;"></div>
                </div>
            </div>
        </div>

        <!-- Sidebar Activity & Metrics -->
        <div class="sidebar">
            <div class="metrics-row">
                <div class="metric-card" onclick="openDirectoryModal()" style="cursor: pointer;"
                    title="Click to view all registered employees">
                    <div class="metric-title"
                        style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Enrolled Gallery</span>
                        <span style="font-size: 0.65rem; color: #60a5fa; font-weight: 600;">View All ➔</span>
                    </div>
                    <div class="metric-val" id="stat-enrolled">--</div>
                </div>
                <div class="metric-card">
                    <div class="metric-title">Active Mode</div>
                    <div class="metric-val" id="stat-mode" style="font-size: 0.95rem; color: var(--accent-green);">ENTRY
                    </div>
                </div>
            </div>

            <div class="logs-panel">
                <div class="logs-header">
                    <div class="logs-title-row">
                        <div class="logs-title">Activity Feed</div>
                        <div class="logs-hint">Tap card for details</div>
                    </div>
                    <div class="tab-bar">
                        <button class="tab-item active-checkin" id="tab-checkin"
                            onclick="setFeedFilter('CHECK_IN')">CHECK-IN</button>
                        <button class="tab-item" id="tab-checkout"
                            onclick="setFeedFilter('CHECK_OUT')">CHECK-OUT</button>
                        <button class="tab-item" id="tab-all" onclick="setFeedFilter('ALL')">ALL FEED</button>
                    </div>
                </div>
                <ul class="activity-list" id="attendance-list">
                    <div class="empty-state">Monitoring camera zone...</div>
                </ul>
            </div>
        </div>
    </div>

    <!-- Attendance Details Modal Lightbox -->
    <div class="modal-overlay" id="modal-overlay" onclick="closeModal(event)">
        <div class="modal-card" id="modal-card" onclick="event.stopPropagation()">
            <div class="modal-top">
                <div>
                    <div class="modal-heading" id="modal-emp-name">EMPLOYEE DETAILS</div>
                    <div class="sub-btn-group" id="modal-sub-buttons" style="margin-top:6px;"></div>
                </div>
                <button class="modal-close-btn" onclick="closeModalDirect()">&times;</button>
            </div>
            <div class="modal-photos-grid">
                <div class="modal-photo-item">
                    <img id="modal-img-captured" src="" alt="Captured Frame">
                    <div class="photo-caption" id="modal-cap-label">Live Frame</div>
                </div>
                <div class="modal-photo-item">
                    <img id="modal-img-enrolled" src="" alt="Official Reference Photo">
                    <div class="photo-caption" style="color: var(--accent-blue);">Official Photo</div>
                </div>
            </div>
            <div class="modal-footer">
                <div>
                    <span style="color: var(--text-muted);" id="modal-time-label">Timestamp: </span>
                    <strong id="modal-time" style="color: #fff;">--:--:--</strong>
                </div>
                <div>
                    <span style="color: var(--text-muted);">Status: </span>
                    <span id="modal-status-badge" style="font-weight: 600;">VERIFIED</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrollment Modal Lightbox -->
    <div class="modal-overlay" id="enroll-modal-overlay" onclick="closeEnrollModal(event)">
        <div class="modal-card" id="enroll-modal-card" style="max-width: 520px;" onclick="event.stopPropagation()">
            <div class="modal-top">
                <div>
                    <div class="modal-heading" style="color: var(--accent-green);">ENROLL NEW EMPLOYEE</div>
                    <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 3px;">
                        Upload a photo or capture with camera to index into FAISS gallery for live recognition.
                    </div>
                </div>
                <button class="modal-close-btn" onclick="closeEnrollModalDirect()">&times;</button>
            </div>

            <form id="enroll-form" onsubmit="handleEnrollSubmit(event)"
                style="display: flex; flex-direction: column; gap: 14px;">
                <!-- Method Selection Tabs: Upload vs Live Camera Snap -->
                <div class="tab-bar" style="margin-bottom: 2px;">
                    <button type="button" class="tab-item active-checkin" id="enroll-tab-upload"
                        onclick="switchEnrollMethod('UPLOAD')">📁 Upload Photo</button>
                    <button type="button" class="tab-item" id="enroll-tab-camera"
                        onclick="switchEnrollMethod('CAMERA')">📷 Live Camera Snap</button>
                </div>

                <!-- 1. Upload Method Section -->
                <div id="enroll-upload-container">
                    <div class="enroll-dropzone" id="enroll-dropzone"
                        onclick="document.getElementById('enroll-file-input').click()">
                        <input type="file" id="enroll-file-input" accept="image/*" style="display: none;"
                            onchange="handleEnrollFileSelect(event)">
                        <div id="dropzone-prompt"
                            style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
                            <div style="font-size: 2.2rem;">📁</div>
                            <div style="font-size: 0.88rem; font-weight: 600; color: var(--text-primary);">Click or Drag
                                Photo to Upload</div>
                            <div style="font-size: 0.7rem; color: var(--text-muted);">Clear frontal face (JPG, PNG,
                                JPEG)</div>
                        </div>
                        <div id="dropzone-preview"
                            style="display: none; flex-direction: column; align-items: center; gap: 8px; width: 100%;">
                            <img id="enroll-preview-img" src="" alt="Preview"
                                style="width: 130px; height: 130px; object-fit: cover; border-radius: 12px; border: 2px solid var(--accent-green); background: #000;">
                            <div style="font-size: 0.72rem; color: var(--accent-cyan); font-weight: 600;">Tap to replace
                                photo</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Live Camera Snap Section -->
                <div id="enroll-camera-container"
                    style="display: none; flex-direction: column; align-items: center; gap: 10px; width: 100%;">
                    <!-- Live Camera Viewport with Oval Face Guide -->
                    <div id="enroll-video-wrapper"
                        style="position: relative; width: 100%; aspect-ratio: 4/3; max-height: 220px; border-radius: 12px; overflow: hidden; background: #000; border: 1.5px solid var(--border-subtle); display: flex; align-items: center; justify-content: center;">
                        <video id="enroll-video" playsinline autoplay muted
                            style="width: 100%; height: 100%; object-fit: cover;"></video>
                        <div
                            style="position: absolute; width: 120px; height: 150px; border-radius: 50%; border: 2px dashed rgba(16, 185, 129, 0.75); pointer-events: none; box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35);">
                        </div>
                        <div
                            style="position: absolute; bottom: 8px; font-size: 0.68rem; color: #fff; background: rgba(0,0,0,0.65); padding: 2px 8px; border-radius: 10px; pointer-events: none;">
                            Center face in oval</div>
                    </div>

                    <!-- Live Camera Buttons -->
                    <div id="enroll-cam-controls"
                        style="display: flex; gap: 8px; width: 100%; justify-content: center;">
                        <button type="button" class="btn-primary"
                            style="padding: 8px 18px; font-size: 0.8rem; min-width: 130px; flex: none;"
                            onclick="snapEnrollPhoto()">
                            <span>📸</span> Snap Photo
                        </button>
                        <button type="button" class="btn-secondary"
                            style="padding: 8px 14px; font-size: 0.8rem; min-width: 80px; flex: none;"
                            onclick="flipEnrollCamera()" title="Flip Front / Rear Camera">
                            <span>🔄</span> Flip
                        </button>
                    </div>

                    <!-- Snapped Photo Frozen Preview -->
                    <div id="enroll-snap-preview"
                        style="display: none; flex-direction: column; align-items: center; gap: 8px; width: 100%;">
                        <img id="enroll-snap-img" src="" alt="Captured Face"
                            style="width: 130px; height: 130px; object-fit: cover; border-radius: 12px; border: 2px solid var(--accent-green); background: #000;">
                        <button type="button" class="btn-secondary"
                            style="padding: 5px 14px; font-size: 0.74rem; min-width: 110px; flex: none;"
                            onclick="retakeEnrollPhoto()">
                            <span>🔄</span> Retake Photo
                        </button>
                    </div>

                    <canvas id="enroll-canvas" style="display: none;"></canvas>
                </div>

                <!-- Input Fields -->
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div>
                        <label
                            style="display: block; font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; letter-spacing: 0.04em;">Full
                            Name <span style="color: var(--accent-red);">*</span></label>
                        <input type="text" id="enroll-name" class="enroll-input" placeholder="e.g. Anas Khan" required
                            autocomplete="off">
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div>
                            <label
                                style="display: block; font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; letter-spacing: 0.04em;">Employee
                                ID <span style="color: var(--accent-red);">*</span></label>
                            <input type="text" id="enroll-emp-id" class="enroll-input" placeholder="e.g. EMP_132"
                                required autocomplete="off">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.7rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; margin-bottom: 5px; letter-spacing: 0.04em;">Department</label>
                            <input type="text" id="enroll-dept" class="enroll-input" placeholder="General"
                                value="General">
                        </div>
                    </div>
                </div>

                <!-- Status / Alert Message -->
                <div id="enroll-msg"
                    style="display: none; padding: 10px 14px; border-radius: 8px; font-size: 0.78rem; line-height: 1.4;">
                </div>

                <!-- Submit Buttons -->
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 4px;">
                    <button type="button" class="btn-secondary"
                        style="padding: 9px 18px; font-size: 0.82rem; min-width: 100px; flex: none;"
                        onclick="closeEnrollModalDirect()">Cancel</button>
                    <button type="submit" id="btn-enroll-submit" class="btn-primary"
                        style="padding: 9px 24px; font-size: 0.85rem; min-width: 160px; flex: none;">
                        <span id="enroll-submit-text">✓ Enroll Employee</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Registered Employees Directory Modal Lightbox -->
    <div class="modal-overlay" id="dir-modal-overlay" onclick="closeDirectoryModal(event)">
        <div class="modal-card" id="dir-modal-card" style="max-width: 680px;" onclick="event.stopPropagation()">
            <div class="modal-top">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div class="modal-heading" style="color: var(--accent-blue);">REGISTERED EMPLOYEES</div>
                    <span id="dir-count-badge" class="badge-tag"
                        style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3); font-size: 0.72rem;">0
                        Enrolled</span>
                </div>
                <button class="modal-close-btn" onclick="closeDirectoryModalDirect()">&times;</button>
            </div>

            <!-- Search and Quick Action Bar -->
            <div style="display: flex; gap: 10px; align-items: center;">
                <input type="text" id="dir-search-input" class="enroll-input"
                    placeholder="🔍 Search employee by name or ID..." oninput="filterDirectoryList()"
                    style="flex: 1; padding: 8px 12px; font-size: 0.82rem;">
                <button type="button" class="enroll-btn" onclick="openEnrollFromDirectory()"
                    style="padding: 8px 14px; font-size: 0.76rem; flex: none;">
                    <span>➕</span> Enroll New
                </button>
            </div>

            <!-- Toast / Message Box -->
            <div id="dir-msg"
                style="display: none; padding: 10px 14px; border-radius: 8px; font-size: 0.78rem; line-height: 1.4;">
            </div>

            <!-- Scrollable Employees List -->
            <div id="dir-employees-list"
                style="display: flex; flex-direction: column; gap: 8px; max-height: 460px; overflow-y: auto; -webkit-overflow-scrolling: touch; padding-right: 4px;">
                <div class="empty-state">Loading registered employees...</div>
            </div>
        </div>
    </div>

    <script>
        // State variables
        let currentRecords = [];
        let activeFeedFilter = 'CHECK_IN';
        let currentSystemMode = 'ENTRY';
        let currentSourceMode = 'LIVE_CAMERA'; // 'LIVE_CAMERA' or 'VIDEO_FEED'

        let selectedEmpSubEvents = {};
        let currentModalEmpId = null;

        // Camera streaming state
        let webcamStream = null;
        let isProcessingFrame = false;
        let isCameraLoopActive = false;
        let currentFacingMode = 'user'; // 'user' (front camera) or 'environment' (rear camera)
        let lastFrameObjectURL = null;

        // Enrollment state
        let selectedEnrollBase64 = null;

        const videoElem = document.getElementById('webcam-video');
        const canvasElem = document.getElementById('capture-canvas');
        const streamImgElem = document.getElementById('stream-img');
        const cameraOverlay = document.getElementById('camera-overlay');
        const camErrorBox = document.getElementById('cam-error-box');

        // -------------------------------------------------------------
        // Linzaer Ultra-Light Fast Generic Face Detector (1MB RFB-320 ONNX)
        // -------------------------------------------------------------
        const liveCanvasElem = document.getElementById('live-viewport-canvas');
        const cropCanvasElem = document.getElementById('crop-canvas');
             // Ultra-Light ONNX State
        let ultraLightSession = null;
        let isUltraLightReady = false;
        let isUltraLightLoading = false;
        let isDetectorBusy = false;
        const UL_WIDTH = 320;
        const UL_HEIGHT = 240;
        const UL_CONF_THRESH = 0.78; // Strict threshold to eliminate curtain/background false positives
        const UL_NMS_THRESH = 0.25;  // Aggressive NMS to eliminate duplicate/nested boxes
        let ulPriors = null;

        // Latency profiling
        let lastDetectMs = 8.0;
        let lastTrackMs = 0.1;
        let lastE2EMs = 8.2;

        // Offscreen 320x240 canvas for Ultra-Light preprocessing
        const ulCanvas = document.createElement('canvas');
        ulCanvas.width = UL_WIDTH;
        ulCanvas.height = UL_HEIGHT;
        const ulCtx = ulCanvas.getContext('2d', { willReadFrequently: true, alpha: false });

        // Pre-compute Ultra-Light RFB-320 Prior Boxes (Linzaer Architecture)
        function initUltraLightPriors() {
            const min_boxes = [[10, 16, 24], [32, 48], [64, 96], [128, 192, 256]];
            const steps = [8, 16, 32, 64];
            const priors = [];

            for (let k = 0; k < steps.length; k++) {
                const f_h = Math.ceil(UL_HEIGHT / steps[k]);
                const f_w = Math.ceil(UL_WIDTH / steps[k]);
                const min_sizes = min_boxes[k];

                for (let i = 0; i < f_h; i++) {
                    for (let j = 0; j < f_w; j++) {
                        for (const min_size of min_sizes) {
                            const s_kx = min_size / UL_WIDTH;
                            const s_ky = min_size / UL_HEIGHT;
                            const cx = (j + 0.5) * steps[k] / UL_WIDTH;
                            const cy = (i + 0.5) * steps[k] / UL_HEIGHT;
                            priors.push(cx, cy, s_kx, s_ky);
                        }
                    }
                }
            }
            ulPriors = new Float32Array(priors);
        }

        async function initUltraLightDetector() {
            if (isUltraLightReady || isUltraLightLoading) return;
            isUltraLightLoading = true;
            initUltraLightPriors();

            if (typeof ort === 'undefined') {
                setTimeout(initUltraLightDetector, 300);
                isUltraLightLoading = false;
                return;
            }

            try {
                ort.env.wasm.numThreads = 2;
                ort.env.wasm.simd = true;

                ultraLightSession = await ort.InferenceSession.create('/models/ultra_light/version-RFB-320.onnx', {
                    executionProviders: ['wasm', 'webgl'],
                    graphOptimizationLevel: 'all'
                });

                isUltraLightReady = true;
                isUltraLightLoading = false;
                console.log("Linzaer Ultra-Light 1MB Face Detector initialized successfully!");
            } catch (err) {
                console.warn("Ultra-Light load warning, using MediaPipe fallback:", err);
                isUltraLightLoading = false;
                initMediaPipeDetector();
            }
        }

        // MediaPipe GPU Fallback
        let isMediaPipeLoaded = false;
        let mpFaceDetector = null;
        let isDetectingAsync = false;
        let latestMpDetections = [];

        function initMediaPipeDetector() {
            if (typeof FaceDetection !== 'undefined' && !mpFaceDetector) {
                try {
                    mpFaceDetector = new FaceDetection({
                        locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_detection/${file}`
                    });
                    mpFaceDetector.setOptions({
                        model: 'short',
                        minDetectionConfidence: 0.45
                    });
                    mpFaceDetector.onResults((results) => {
                        isDetectingAsync = false;
                        latestMpDetections = results.detections || [];
                    });
                    isMediaPipeLoaded = true;
                } catch (e) {
                    console.warn("MediaPipe init error:", e);
                }
            }
        }

        // High-Performance Smooth IoUTracker with Motion Velocity Prediction & Permanent Identity Lock
        class ClientIoUTracker {
            constructor(iouThreshold = 0.20, maxAge = 35, minHits = 2) {
                this.iouThreshold = iouThreshold;
                this.maxAge = maxAge;
                this.minHits = minHits;
                this.nextId = 101;
                this.tracks = [];
                this.frameCount = 0;
            }

            update(detections) {
                this.frameCount++;

                for (const t of this.tracks) {
                    t.age++;
                    t.time_since_update++;
                    // Smooth motion interpolation between detection cycles
                    if (t.time_since_update > 0 && t.time_since_update <= 6) {
                        t.bbox[0] += (t.vx || 0) * 0.8;
                        t.bbox[1] += (t.vy || 0) * 0.8;
                        t.bbox[2] += (t.vx || 0) * 0.8;
                        t.bbox[3] += (t.vy || 0) * 0.8;
                    }
                }

                if (detections.length === 0) {
                    this.tracks = this.tracks.filter(t => t.time_since_update <= this.maxAge);
                    return this.tracks.filter(t => t.time_since_update <= 15);
                }

                if (this.tracks.length === 0) {
                    const matchedTracks = [];
                    for (const d of detections) {
                        const newT = {
                            track_id: this.nextId++,
                            bbox: [...d.bbox],
                            score: d.score,
                            kps: d.kps || [],
                            hits: 1,
                            age: 1,
                            time_since_update: 0,
                            vx: 0,
                            vy: 0,
                            assigned_identity: null,
                            employee_id: null,
                            similarity_score: 0.0,
                            confirmed: false,
                            recognition_stale: true,
                            last_recognition_frame: 0,
                            recognition_state: 'UNKNOWN',
                            photo_url: null,
                            decision: 'UNKNOWN',
                            cropInFlight: false,
                            lastCropAttemptTime: 0
                        };
                        this.tracks.push(newT);
                        matchedTracks.push(newT);
                    }
                    return matchedTracks;
                }

                // Compute IoU Matrix against existing tracks
                const iouMatrix = [];
                for (let i = 0; i < this.tracks.length; i++) {
                    iouMatrix[i] = [];
                    for (let j = 0; j < detections.length; j++) {
                        iouMatrix[i][j] = this._computeIoU(this.tracks[i].bbox, detections[j].bbox);
                    }
                }

                const matchedTrackIndices = new Set();
                const matchedDetIndices = new Set();

                while (true) {
                    let maxIoU = -1;
                    let maxT = -1;
                    let maxD = -1;

                    for (let t = 0; t < this.tracks.length; t++) {
                        if (matchedTrackIndices.has(t)) continue;
                        for (let d = 0; d < detections.length; d++) {
                            if (matchedDetIndices.has(d)) continue;
                            if (iouMatrix[t][d] > maxIoU) {
                                maxIoU = iouMatrix[t][d];
                                maxT = t;
                                maxD = d;
                            }
                        }
                    }

                    if (maxIoU < this.iouThreshold || maxT === -1) break;

                    matchedTrackIndices.add(maxT);
                    matchedDetIndices.add(maxD);

                    const track = this.tracks[maxT];
                    const det = detections[maxD];

                    // Smooth velocity calculation
                    const oldCx = (track.bbox[0] + track.bbox[2]) / 2.0;
                    const oldCy = (track.bbox[1] + track.bbox[3]) / 2.0;
                    const newCx = (det.bbox[0] + det.bbox[2]) / 2.0;
                    const newCy = (det.bbox[1] + det.bbox[3]) / 2.0;
                    
                    const instVx = (newCx - oldCx) * 0.35;
                    const instVy = (newCy - oldCy) * 0.35;
                    track.vx = (track.vx || 0) * 0.7 + instVx * 0.3;
                    track.vy = (track.vy || 0) * 0.7 + instVy * 0.3;

                    // Smooth exponential filter (0.75 det, 0.25 track)
                    track.bbox = [
                        0.75 * det.bbox[0] + 0.25 * track.bbox[0],
                        0.75 * det.bbox[1] + 0.25 * track.bbox[1],
                        0.75 * det.bbox[2] + 0.25 * track.bbox[2],
                        0.75 * det.bbox[3] + 0.25 * track.bbox[3]
                    ];
                    track.score = det.score;
                    if (det.kps && det.kps.length > 0) track.kps = det.kps;
                    track.hits++;
                    track.time_since_update = 0;
                }

                for (let d = 0; d < detections.length; d++) {
                    if (!matchedDetIndices.has(d)) {
                        const det = detections[d];
                        const newT = {
                            track_id: this.nextId++,
                            bbox: [...det.bbox],
                            score: det.score,
                            kps: det.kps || [],
                            hits: 1,
                            age: 1,
                            time_since_update: 0,
                            vx: 0,
                            vy: 0,
                            assigned_identity: null,
                            employee_id: null,
                            similarity_score: 0.0,
                            confirmed: false,
                            recognition_stale: true,
                            last_recognition_frame: 0,
                            recognition_state: 'UNKNOWN',
                            photo_url: null,
                            decision: 'UNKNOWN',
                            cropInFlight: false,
                            lastCropAttemptTime: 0
                        };
                        this.tracks.push(newT);
                    }
                }

                // Inter-track deduplication: Merge any duplicate or nested tracks on the same face
                const validTracks = [];
                for (let i = 0; i < this.tracks.length; i++) {
                    const tA = this.tracks[i];
                    if (tA.time_since_update > this.maxAge) continue;
                    let isDuplicate = false;
                    for (let j = 0; j < validTracks.length; j++) {
                        const tB = validTracks[j];
                        const iou = this._computeIoU(tA.bbox, tB.bbox);
                        const iom = this._computeIoM(tA.bbox, tB.bbox);
                        if (iou >= 0.22 || iom >= 0.38) {
                            // If tA is MATCHED and tB is not, transfer match to tB
                            if (tA.recognition_state === 'MATCHED' && tB.recognition_state !== 'MATCHED') {
                                tB.recognition_state = 'MATCHED';
                                tB.assigned_identity = tA.assigned_identity;
                                tB.employee_id = tA.employee_id;
                                tB.similarity_score = tA.similarity_score;
                                tB.photo_url = tA.photo_url;
                                tB.decision = tA.decision;
                                tB.confirmed = true;
                            }
                            isDuplicate = true;
                            break;
                        }
                    }
                    if (!isDuplicate) validTracks.push(tA);
                }
                this.tracks = validTracks;
                return this.tracks.filter(t => t.time_since_update <= 15);
            }

            _computeIoU(boxA, boxB) {
                const xA = Math.max(boxA[0], boxB[0]);
                const yA = Math.max(boxA[1], boxB[1]);
                const xB = Math.min(boxA[2], boxB[2]);
                const yB = Math.min(boxA[3], boxB[3]);

                const interArea = Math.max(0, xB - xA + 1) * Math.max(0, yB - yA + 1);
                const boxAArea = (boxA[2] - boxA[0] + 1) * (boxA[3] - boxA[1] + 1);
                const boxBArea = (boxB[2] - boxB[0] + 1) * (boxB[3] - boxB[1] + 1);

                return interArea / (boxAArea + boxBArea - interArea);
            }

            _computeIoM(boxA, boxB) {
                const xA = Math.max(boxA[0], boxB[0]);
                const yA = Math.max(boxA[1], boxB[1]);
                const xB = Math.min(boxA[2], boxB[2]);
                const yB = Math.min(boxA[3], boxB[3]);
                const inter = Math.max(0, xB - xA) * Math.max(0, yB - yA);
                const areaA = Math.max(1, (boxA[2] - boxA[0]) * (boxA[3] - boxA[1]));
                const areaB = Math.max(1, (boxB[2] - boxB[0]) * (boxB[3] - boxB[1]));
                return inter / Math.min(areaA, areaB);
            }
        }

        const clientTracker = new ClientIoUTracker(0.20, 35, 2);
        let activeIdCardPopup = null;
        let enrolledPhotoCache = {};
        let clientFps = 30.0;
        let clientFrameCounter = 0;
        let lastFpsTime = performance.now();
        const MIN_RECOGNITION_SIZE = 120; // Exact 120px production size gate

        // Run Linzaer Ultra-Light Fast Inference (320x240 -> Planar Float32 -> Prior Decode -> Strict NMS)
        async function runUltraLightInference(video, vw, vh) {
            if (!ultraLightSession || !isUltraLightReady || !ulPriors) return null;

            const t0 = performance.now();
            ulCtx.drawImage(video, 0, 0, UL_WIDTH, UL_HEIGHT);
            const imgData = ulCtx.getImageData(0, 0, UL_WIDTH, UL_HEIGHT);
            const pixels = imgData.data;

            // Planar Float32 NCHW: (X - 127.0) / 128.0
            const floatData = new Float32Array(1 * 3 * UL_HEIGHT * UL_WIDTH);
            const planeSize = UL_WIDTH * UL_HEIGHT;
            for (let i = 0; i < planeSize; i++) {
                const pxIdx = i * 4;
                floatData[i] = (pixels[pxIdx] - 127.0) / 128.0;
                floatData[planeSize + i] = (pixels[pxIdx + 1] - 127.0) / 128.0;
                floatData[planeSize * 2 + i] = (pixels[pxIdx + 2] - 127.0) / 128.0;
            }

            const inputTensor = new ort.Tensor('float32', floatData, [1, 3, UL_HEIGHT, UL_WIDTH]);
            const netOuts = await ultraLightSession.run({ input: inputTensor });

            const scores = netOuts.scores.data;
            const boxes = netOuts.boxes.data;
            const numPriors = ulPriors.length / 4;
            const detections = [];

            for (let i = 0; i < numPriors; i++) {
                const score = scores[i * 2 + 1];
                if (score >= UL_CONF_THRESH) {
                    const pCx = ulPriors[i * 4];
                    const pCy = ulPriors[i * 4 + 1];
                    const pW = ulPriors[i * 4 + 2];
                    const pH = ulPriors[i * 4 + 3];

                    const locX = boxes[i * 4];
                    const locY = boxes[i * 4 + 1];
                    const locW = boxes[i * 4 + 2];
                    const locH = boxes[i * 4 + 3];

                    const boxCx = pCx + locX * 0.1 * pW;
                    const boxCy = pCy + locY * 0.1 * pH;
                    const boxW = pW * Math.exp(locW * 0.2);
                    const boxH = pH * Math.exp(locH * 0.2);

                    const x1 = Math.max(0, (boxCx - boxW / 2.0) * vw);
                    const y1 = Math.max(0, (boxCy - boxH / 2.0) * vh);
                    const x2 = Math.min(vw, (boxCx + boxW / 2.0) * vw);
                    const y2 = Math.min(vh, (boxCy + boxH / 2.0) * vh);

                    const bw = x2 - x1;
                    const bh = y2 - y1;

                    // Filter out tiny false positives (e.g. curtain dots < 40px)
                    if (bw >= 40 && bh >= 40) {
                        detections.push({
                            bbox: [x1, y1, x2, y2],
                            score: score,
                            kps: []
                        });
                    }
                }
            }

            lastDetectMs = performance.now() - t0;
            return applyUltraLightNMS(detections, UL_NMS_THRESH);
        }

        function applyUltraLightNMS(dets, nmsThresh) {
            if (dets.length <= 1) return dets;
            // Sort descending by detection score
            dets.sort((a, b) => b.score - a.score);
            const keep = [];
            const suppressed = new Uint8Array(dets.length);

            for (let i = 0; i < dets.length; i++) {
                if (suppressed[i]) continue;
                keep.push(dets[i]);
                for (let j = i + 1; j < dets.length; j++) {
                    if (suppressed[j]) continue;
                    const iou = calcBoxIoU(dets[i].bbox, dets[j].bbox);
                    const iom = calcIoM(dets[i].bbox, dets[j].bbox);
                    // Suppress if overlapping or one box is inside another
                    if (iou >= nmsThresh || iom >= 0.40) {
                        suppressed[j] = 1;
                    }
                }
            }
            return keep;
        }

        // Intersection over Minimum Area (detects nested inner/outer boxes regardless of order)
        function calcIoM(boxA, boxB) {
            const xA = Math.max(boxA[0], boxB[0]);
            const yA = Math.max(boxA[1], boxB[1]);
            const xB = Math.min(boxA[2], boxB[2]);
            const yB = Math.min(boxA[3], boxB[3]);
            const inter = Math.max(0, xB - xA) * Math.max(0, yB - yA);
            const areaA = Math.max(1, (boxA[2] - boxA[0]) * (boxA[3] - boxA[1]));
            const areaB = Math.max(1, (boxB[2] - boxB[0]) * (boxB[3] - boxB[1]));
            return inter / Math.min(areaA, areaB);
        }

        function calcBoxIoU(boxA, boxB) {
            const xA = Math.max(boxA[0], boxB[0]);
            const yA = Math.max(boxA[1], boxB[1]);
            const xB = Math.min(boxA[2], boxB[2]);
            const yB = Math.min(boxA[3], boxB[3]);
            const inter = Math.max(0, xB - xA + 1) * Math.max(0, yB - yA + 1);
            const areaA = (boxA[2] - boxA[0] + 1) * (boxA[3] - boxA[1] + 1);
            const areaB = (boxB[2] - boxB[0] + 1) * (boxB[3] - boxB[1] + 1);
            return inter / (areaA + areaB - inter);
        }

        // -------------------------------------------------------------
        // Video Source Switching (Live Camera vs Pre-recorded Video Feed)
        // -------------------------------------------------------------
        function setVideoSourceMode(mode) {
            currentSourceMode = mode;
            const btnLive = document.getElementById('btn-source-live');
            const btnFeed = document.getElementById('btn-source-feed');
            const pulseDot = document.getElementById('stream-pulse-dot');
            const label = document.getElementById('stream-source-label');
            const flipBtn = document.getElementById('btn-flip-cam');
            const stopBtn = document.getElementById('btn-stop-cam');

            if (mode === 'LIVE_CAMERA') {
                btnLive.className = 'control-btn active-live';
                btnFeed.className = 'control-btn';
                pulseDot.className = 'pulse-dot';
                label.innerText = 'LIVE CAMERA (ULTRA-LIGHT 1MB & IoU TRACKER)';

                streamImgElem.removeAttribute('src');
                streamImgElem.src = '';
                streamImgElem.style.display = 'none';
                liveCanvasElem.style.display = 'block';

                if (!webcamStream) {
                    cameraOverlay.classList.remove('hidden');
                    flipBtn.style.display = 'none';
                    stopBtn.style.display = 'none';
                } else {
                    cameraOverlay.classList.add('hidden');
                    flipBtn.style.display = 'inline-flex';
                    stopBtn.style.display = 'inline-flex';
                    isCameraLoopActive = true;
                    requestAnimationFrame(runClientLiveLoop);
                }
            } else {
                btnLive.className = 'control-btn';
                btnFeed.className = 'control-btn active-feed';
                pulseDot.className = 'pulse-dot dot-feed';
                label.innerText = 'VIDEO FEED (Live_Feed.mp4)';
                flipBtn.style.display = 'none';
                stopBtn.style.display = 'none';

                liveCanvasElem.style.display = 'none';
                streamImgElem.style.display = 'block';

                stopWebcam();
                cameraOverlay.classList.add('hidden');

                streamImgElem.removeAttribute('src');
                streamImgElem.src = '';
                setTimeout(() => {
                    streamImgElem.src = '/video_feed?t=' + Date.now();
                }, 60);
            }
        }

        // -------------------------------------------------------------
        // WebRTC Live Camera Management
        // -------------------------------------------------------------
        function startLiveCapture() {
            camErrorBox.style.display = 'none';
            if (location.protocol === 'http:' && location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
                location.href = location.href.replace('http://', 'https://');
                return;
            }
            startWebcam();
        }

        async function startWebcam() {
            camErrorBox.style.display = 'none';
            camErrorBox.innerHTML = '';
            document.getElementById('btn-open-camera').innerText = 'Starting Ultra-Light Engine...';

            if (!isUltraLightReady && !isUltraLightLoading) {
                initUltraLightDetector();
            }

            const supported = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
            if (!supported) {
                showCameraError('Live camera requires HTTPS or a modern browser supporting WebRTC.');
                document.getElementById('btn-open-camera').innerHTML = '<span>🎥</span> Start Live Capture';
                return;
            }

            const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (window.innerWidth <= 768);
            const targetWidth = isMobile ? 480 : 640;
            const targetHeight = isMobile ? 360 : 480;

            try {
                webcamStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: { ideal: currentFacingMode },
                        width: { ideal: targetWidth, max: 640 },
                        height: { ideal: targetHeight, max: 480 },
                        frameRate: { ideal: 30, max: 30 }
                    },
                    audio: false
                });
            } catch (err1) {
                try {
                    webcamStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: currentFacingMode },
                        audio: false
                    });
                } catch (err2) {
                    let errMsg = `Live camera unavailable (${err2.name || err2.message}).`;
                    if (err2.name === 'NotAllowedError' || err2.name === 'PermissionDeniedError') {
                        errMsg = 'Camera permission was blocked. Please click the camera/lock icon in your browser address bar and select "Allow".';
                    } else if (err2.name === 'NotFoundError' || err2.name === 'DevicesNotFoundError') {
                        errMsg = 'No camera found on this device. You can switch to "Video Feed" mode.';
                    }
                    showCameraError(errMsg);
                    document.getElementById('btn-open-camera').innerHTML = '<span>🎥</span> Start Live Capture';
                    return;
                }
            }

            try {
                videoElem.srcObject = webcamStream;
                videoElem.setAttribute('playsinline', 'true');
                await videoElem.play();

                cameraOverlay.classList.add('hidden');
                document.getElementById('btn-open-camera').innerHTML = '<span>🎥</span> Start Live Capture';
                document.getElementById('btn-flip-cam').style.display = 'inline-flex';
                document.getElementById('btn-stop-cam').style.display = 'inline-flex';
                
                streamImgElem.style.display = 'none';
                liveCanvasElem.style.display = 'block';
                isCameraLoopActive = true;

                requestAnimationFrame(runClientLiveLoop);
            } catch (err) {
                stopWebcam();
                showCameraError(`Failed to start preview: ${err.message}`);
                document.getElementById('btn-open-camera').innerHTML = '<span>🎥</span> Start Live Capture';
            }
        }

        function stopWebcam() {
            isCameraLoopActive = false;
            if (webcamStream) {
                webcamStream.getTracks().forEach(track => track.stop());
                webcamStream = null;
            }
            if (videoElem) {
                videoElem.srcObject = null;
            }
            clientTracker.tracks = [];
        }

        function toggleCameraActive() {
            const stopBtn = document.getElementById('btn-stop-cam');
            if (isCameraLoopActive) {
                isCameraLoopActive = false;
                stopBtn.innerHTML = '<span>▶</span> Resume';
            } else {
                if (!webcamStream) {
                    startLiveCapture();
                } else {
                    isCameraLoopActive = true;
                    stopBtn.innerHTML = '<span>⏹</span> Pause';
                    requestAnimationFrame(runClientLiveLoop);
                }
            }
        }

        async function flipCameraFacingMode() {
            currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            stopWebcam();
            await startWebcam();
        }

        function showCameraError(msg) {
            camErrorBox.innerHTML = msg;
            camErrorBox.style.display = 'block';
        }

        // -------------------------------------------------------------
        // CLIENT LIVE LOOP (Native Smooth Display Refresh + Ultra-Light Detection)
        // -------------------------------------------------------------
        function runClientLiveLoop() {
            if (!isCameraLoopActive || currentSourceMode !== 'LIVE_CAMERA') return;

            const tFrameStart = performance.now();

            try {
                if (videoElem.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA && videoElem.videoWidth > 0) {
                    const vw = videoElem.videoWidth;
                    const vh = videoElem.videoHeight;

                    if (liveCanvasElem.width !== vw || liveCanvasElem.height !== vh) {
                        liveCanvasElem.width = vw;
                        liveCanvasElem.height = vh;
                        liveCtx = liveCanvasElem.getContext('2d', { alpha: false });
                    }
                    if (!liveCtx) liveCtx = liveCanvasElem.getContext('2d', { alpha: false });

                    // 1. Draw raw webcam frame directly to local canvas
                    liveCtx.drawImage(videoElem, 0, 0, vw, vh);

                    // 2. Measure actual smooth FPS
                    const now = performance.now();
                    clientFrameCounter++;
                    if (now - lastFpsTime >= 1000) {
                        clientFps = (clientFrameCounter * 1000) / (now - lastFpsTime);
                        clientFrameCounter = 0;
                        lastFpsTime = now;
                    }

                    // 3. Ultra-Light ONNX Detection
                    if (isUltraLightReady && !isDetectorBusy) {
                        isDetectorBusy = true;
                        runUltraLightInference(videoElem, vw, vh).then((dets) => {
                            isDetectorBusy = false;
                            if (dets) {
                                const tTrackS = performance.now();
                                clientTracker.update(dets);
                                lastTrackMs = performance.now() - tTrackS;
                            }
                        }).catch(() => { isDetectorBusy = false; });
                    } else if (!isUltraLightReady && isMediaPipeLoaded && mpFaceDetector) {
                        if (!isDetectingAsync) {
                            isDetectingAsync = true;
                            mpFaceDetector.send({ image: videoElem }).catch(() => { isDetectingAsync = false; });
                        }
                        if (latestMpDetections && latestMpDetections.length > 0) {
                            const mpDets = latestMpDetections.map(d => {
                                const bb = d.boundingBox;
                                const x1 = Math.max(0, (bb.xCenter - bb.width / 2) * vw);
                                const y1 = Math.max(0, (bb.yCenter - bb.height / 2) * vh);
                                const x2 = Math.min(vw, (bb.xCenter + bb.width / 2) * vw);
                                const y2 = Math.min(vh, (bb.yCenter + bb.height / 2) * vh);
                                return { bbox: [x1, y1, x2, y2], score: d.score ? d.score[0] : 0.9, kps: [] };
                            });
                            clientTracker.update(mpDets);
                        }
                    }

                    // 4. Check 120px Recognition Size Gate & Dispatch Crops
                    checkAndDispatchCropsIoU(vw, vh, now);

                    // 5. Render Tracking Bounding Boxes & HUD (Identical to Video Feed)
                    renderIoUTracksAndHUD(vw, vh, now);

                    lastE2EMs = performance.now() - tFrameStart;
                }
            } catch (loopErr) {
                console.error("ClientLiveLoop error:", loopErr);
            }

            if (isCameraLoopActive && currentSourceMode === 'LIVE_CAMERA') {
                requestAnimationFrame(runClientLiveLoop);
            }
        }

        // Dedicated 224x224 crop canvas
        const cropOffscreenCanvas = document.createElement('canvas');
        cropOffscreenCanvas.width = 224;
        cropOffscreenCanvas.height = 224;
        const cropOffscreenCtx = cropOffscreenCanvas.getContext('2d', { willReadFrequently: true, alpha: false });

        // High-Speed Size Gate & Selective Recognition for IoU Tracks
        function checkAndDispatchCropsIoU(vw, vh, now) {
            // Sort active tracks by bounding box area descending
            const candidateTracks = clientTracker.tracks
                .filter(t => t.time_since_update <= 10)
                .sort((a, b) => {
                    const areaA = (a.bbox[2] - a.bbox[0]) * (a.bbox[3] - a.bbox[1]);
                    const areaB = (b.bbox[2] - b.bbox[0]) * (b.bbox[3] - b.bbox[1]);
                    return areaB - areaA;
                });

            for (let i = 0; i < candidateTracks.length; i++) {
                const track = candidateTracks[i];
                const boxW = track.bbox[2] - track.bbox[0];
                const boxH = track.bbox[3] - track.bbox[1];
                const faceSize = Math.max(boxW, boxH);

                if (faceSize < MIN_RECOGNITION_SIZE) {
                    if (track.recognition_state !== 'MATCHED') {
                        track.recognition_state = 'WAITING_FOR_SIZE';
                    }
                    continue;
                }

                // If already matched, permanent identity lock is ACTIVE
                if (track.recognition_state === 'MATCHED') continue;

                // Evaluate top 2 prominent faces concurrently
                if (i >= 2 && track.recognition_state !== 'MATCHED') {
                    continue;
                }

                // Fast retry: If not recognized on previous frame (e.g. motion blur), retry after 150ms
                if (track.recognition_state === 'RECOGNITION_FAILED' && (now - track.lastCropAttemptTime < 150)) {
                    continue;
                }

                if (!track.cropInFlight && (now - track.lastCropAttemptTime > 120)) {
                    track.cropInFlight = true;
                    track.lastCropAttemptTime = now;
                    track.recognition_state = 'RECOGNIZING';

                    // 25% margin padding
                    const padX = Math.max(10, Math.round(boxW * 0.25));
                    const padY = Math.max(10, Math.round(boxH * 0.25));
                    const cropX = Math.max(0, Math.round(track.bbox[0] - padX));
                    const cropY = Math.max(0, Math.round(track.bbox[1] - padY));
                    const cropW = Math.max(30, Math.min(vw - cropX, Math.round(boxW + padX * 2)));
                    const cropH = Math.max(30, Math.min(vh - cropY, Math.round(boxH + padY * 2)));

                    cropOffscreenCtx.drawImage(videoElem, cropX, cropY, cropW, cropH, 0, 0, 224, 224);

                    const cropBase64 = cropOffscreenCanvas.toDataURL('image/jpeg', 0.95);
                    const fullFrameBase64 = liveCanvasElem.toDataURL('image/jpeg', 0.92);

                    (async () => {
                        try {
                            const resp = await fetch('/api/process_crop', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    crop_base64: cropBase64,
                                    full_frame_base64: fullFrameBase64
                                })
                            });

                            if (resp.ok) {
                                const data = await resp.json();

                                if (data.status === 'SUCCESS' && data.matched) {
                                    // MATCHED! Turn GREEN & lock identity
                                    track.recognition_state = 'MATCHED';
                                    track.assigned_identity = data.name;
                                    track.employee_id = data.employee_id;
                                    track.similarity_score = data.confidence;
                                    track.photo_url = data.photo_url;
                                    track.decision = data.decision || (currentSystemMode === 'EXIT' ? 'CHECK_OUT' : 'CHECK_IN');
                                    track.confirmed = true;

                                    if (data.event_recorded || !activeIdCardPopup) {
                                        activeIdCardPopup = {
                                            name: data.name,
                                            employee_id: data.employee_id,
                                            confidence: data.confidence,
                                            decision: track.decision,
                                            photo_url: data.photo_url,
                                            until: performance.now() + 2000
                                        };
                                        if (data.photo_url && !enrolledPhotoCache[data.photo_url]) {
                                            const img = new Image();
                                            img.src = data.photo_url;
                                            img.onload = () => { enrolledPhotoCache[data.photo_url] = img; };
                                        }
                                    }
                                } else {
                                    track.recognition_state = 'RECOGNITION_FAILED';
                                    track.assigned_identity = 'UNKNOWN PERSON';
                                    track.similarity_score = data.confidence || 0;
                                    track.decision = 'UNKNOWN';
                                }
                            }
                        } catch (err) {
                            console.error('[CropEngine] Recognition error:', err);
                        } finally {
                            track.cropInFlight = false;
                        }
                    })();
                }
            }
        }

        // Render Exact Video Feed Style Bounding Boxes, HUD & Flashing ID Card
        function renderIoUTracksAndHUD(vw, vh, now) {
            let activeTrackCount = 0;

            for (const track of clientTracker.tracks) {
                if (track.time_since_update > 15) continue;

                activeTrackCount++;
                const bx = Math.round(track.bbox[0]);
                const by = Math.round(track.bbox[1]);
                const bw = Math.round(track.bbox[2] - track.bbox[0]);
                const bh = Math.round(track.bbox[3] - track.bbox[1]);

                // Matching src/pipeline.py color & label rules:
                // Red until it becomes Green (CHECK_IN), Orange (RE_ENTRY), or Purple (CHECK_OUT)
                let boxColor = '#ff0000'; // Pure Red
                let labelText = "UNKNOWN PERSON";

                if (track.recognition_state === 'MATCHED' && track.assigned_identity) {
                    const dec = track.decision;
                    if (dec === 'CHECK_OUT') {
                        boxColor = '#ff00b4'; // Bright Purple (255, 0, 180)
                        labelText = `CHECK-OUT: ${track.assigned_identity} [${Math.round(track.similarity_score * 100)}%]`;
                    } else if (dec === 'RE_ENTRY') {
                        boxColor = '#ff8c00'; // Bright Orange (0, 165, 255)
                        labelText = `RE-ENTRY: ${track.assigned_identity} [${Math.round(track.similarity_score * 100)}%]`;
                    } else {
                        boxColor = '#00ff00'; // Bright Green (0, 255, 0)
                        labelText = `${track.assigned_identity} [${Math.round(track.similarity_score * 100)}%]`;
                    }
                } else {
                    boxColor = '#ff0000'; // Pure Red
                    labelText = "UNKNOWN PERSON";
                }

                // Draw bounding box (2px width like OpenCV)
                liveCtx.lineWidth = 2;
                liveCtx.strokeStyle = boxColor;
                liveCtx.strokeRect(bx, by, bw, bh);

                // Draw label header banner (identical to OpenCV cv2.putText & cv2.rectangle)
                liveCtx.font = 'bold 12px "DejaVu Sans", "Helvetica Neue", Arial, sans-serif';
                const textMetrics = liveCtx.measureText(labelText);
                const labelW = textMetrics.width + 10;
                const labelH = 24;
                const labelY = Math.max(0, by - labelH);

                liveCtx.fillStyle = boxColor;
                liveCtx.fillRect(bx, labelY, labelW, labelH);
                liveCtx.fillStyle = '#ffffff';
                liveCtx.fillText(labelText, bx + 5, labelY + 16);
            }

            // Draw Top-Left Diagnostics HUD Box (Matching _draw_hud in src/pipeline.py)
            const hudW = 320;
            const hudH = 75;
            liveCtx.fillStyle = '#000000';
            liveCtx.fillRect(10, 10, hudW, hudH);
            
            const hudBorderColor = currentSystemMode === 'EXIT' ? '#ff00b4' : '#00ff00';
            liveCtx.strokeStyle = hudBorderColor;
            liveCtx.lineWidth = 1;
            liveCtx.strokeRect(10, 10, hudW, hudH);

            liveCtx.font = '12px "DejaVu Sans", "Helvetica Neue", Arial, sans-serif';
            liveCtx.fillStyle = '#ffffff';
            liveCtx.fillText(`MODE: ${currentSystemMode} | FPS: ${clientFps.toFixed(1)} | Tracks: ${activeTrackCount}`, 18, 30);
            liveCtx.fillText(`Detect: ${lastDetectMs.toFixed(1)}ms | Track: ${lastTrackMs.toFixed(1)}ms`, 18, 50);
            liveCtx.fillText(`End-to-End Latency: ${lastE2EMs.toFixed(1)}ms`, 18, 70);

            // Draw Flashing Official ID Card HUD (Top Right, Matching _draw_id_card_hud in src/pipeline.py)
            if (activeIdCardPopup && now < activeIdCardPopup.until) {
                const cardW = 360;
                const cardH = 130;
                const cardX = vw - cardW - 20;
                const cardY = 20;

                let cardBorderColor = '#00ff00'; // Green
                let headerTitle = 'OFFICIAL ID CARD VERIFIED';
                if (activeIdCardPopup.decision === 'CHECK_OUT') {
                    cardBorderColor = '#ff00b4'; // Purple
                    headerTitle = 'CHECK-OUT VERIFIED';
                } else if (activeIdCardPopup.decision === 'RE_ENTRY') {
                    cardBorderColor = '#ff8c00'; // Orange
                    headerTitle = 'RE-ENTRY VERIFIED';
                }

                // Card Background ROI Overlay
                liveCtx.fillStyle = 'rgba(20, 30, 20, 0.85)';
                liveCtx.fillRect(cardX, cardY, cardW, cardH);
                liveCtx.strokeStyle = cardBorderColor;
                liveCtx.lineWidth = 3;
                liveCtx.strokeRect(cardX, cardY, cardW, cardH);

                // Photo Box (90x105)
                const photoX = cardX + 12;
                const photoY = cardY + 12;
                const photoW = 90;
                const photoH = 105;

                liveCtx.fillStyle = '#000000';
                liveCtx.fillRect(photoX, photoY, photoW, photoH);

                const cachedImg = activeIdCardPopup.photo_url ? enrolledPhotoCache[activeIdCardPopup.photo_url] : null;
                if (cachedImg && cachedImg.complete) {
                    liveCtx.drawImage(cachedImg, photoX, photoY, photoW, photoH);
                } else {
                    liveCtx.font = '28px sans-serif';
                    liveCtx.fillStyle = '#64748b';
                    liveCtx.fillText('👤', photoX + 30, photoY + 60);
                }
                liveCtx.strokeStyle = cardBorderColor;
                liveCtx.lineWidth = 1;
                liveCtx.strokeRect(photoX, photoY, photoW, photoH);

                // Text Lines
                const textX = cardX + 115;
                liveCtx.font = 'bold 11px "DejaVu Sans", Arial, sans-serif';
                liveCtx.fillStyle = '#00ffff';
                liveCtx.fillText(headerTitle, textX, cardY + 26);

                liveCtx.font = 'bold 13px "DejaVu Sans", Arial, sans-serif';
                liveCtx.fillStyle = '#ffffff';
                liveCtx.fillText(`NAME: ${activeIdCardPopup.name}`, textX, cardY + 52);

                liveCtx.font = '12px "DejaVu Sans", Arial, sans-serif';
                liveCtx.fillStyle = cardBorderColor;
                liveCtx.fillText(`ID: ${activeIdCardPopup.employee_id}`, textX, cardY + 76);

                liveCtx.font = '11px "DejaVu Sans", Arial, sans-serif';
                liveCtx.fillStyle = '#c8c8c8';
                liveCtx.fillText(`MATCH: ${Math.round(activeIdCardPopup.confidence * 100)}%`, textX, cardY + 98);
            }
        }



        // -------------------------------------------------------------
        // System Operation Mode (ENTRY vs EXIT)
        // -------------------------------------------------------------
        async function switchSystemMode(mode) {
            try {
                const res = await fetch('/api/mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode: mode })
                });
                const data = await res.json();
                if (data.status === 'SUCCESS') {
                    currentSystemMode = data.mode;
                    updateModeUI(data.mode);

                    if (currentSourceMode === 'VIDEO_FEED') {
                        streamImgElem.src = '/video_feed?t=' + new Date().getTime();
                    }

                    if (mode === 'EXIT') {
                        setFeedFilter('CHECK_OUT');
                    } else {
                        setFeedFilter('CHECK_IN');
                    }
                }
            } catch (err) {
                console.error("Error switching mode:", err);
            }
        }

        function updateModeUI(mode) {
            const btnEntry = document.getElementById('btn-mode-entry');
            const btnExit = document.getElementById('btn-mode-exit');
            const statMode = document.getElementById('stat-mode');

            if (mode === 'EXIT') {
                btnEntry.className = 'control-btn';
                btnExit.className = 'control-btn active-exit';
                statMode.innerText = 'EXIT';
                statMode.style.color = 'var(--accent-purple)';
            } else {
                btnEntry.className = 'control-btn active-entry';
                btnExit.className = 'control-btn';
                statMode.innerText = 'ENTRY';
                statMode.style.color = 'var(--accent-green)';
            }
        }

        // -------------------------------------------------------------
        // Employee Enrollment Modal & Submission (Upload & Live Snap)
        // -------------------------------------------------------------
        let enrollActiveMethod = 'UPLOAD';
        let enrollWebcamStream = null;
        let enrollFacingMode = 'user';

        function openEnrollModal() {
            document.getElementById('enroll-form').reset();
            selectedEnrollBase64 = null;

            const msgBox = document.getElementById('enroll-msg');
            msgBox.style.display = 'none';
            msgBox.innerHTML = '';

            switchEnrollMethod('UPLOAD');
            document.getElementById('enroll-modal-overlay').classList.add('active');
        }

        function closeEnrollModalDirect() {
            stopEnrollCamera();
            document.getElementById('enroll-modal-overlay').classList.remove('active');
            selectedEnrollBase64 = null;
        }

        function closeEnrollModal(event) {
            if (event.target.id === 'enroll-modal-overlay') {
                closeEnrollModalDirect();
            }
        }

        function switchEnrollMethod(method) {
            enrollActiveMethod = method;
            const tabUpload = document.getElementById('enroll-tab-upload');
            const tabCamera = document.getElementById('enroll-tab-camera');
            const uploadCont = document.getElementById('enroll-upload-container');
            const cameraCont = document.getElementById('enroll-camera-container');

            if (method === 'UPLOAD') {
                tabUpload.className = 'tab-item active-checkin';
                tabCamera.className = 'tab-item';
                uploadCont.style.display = 'block';
                cameraCont.style.display = 'none';
                stopEnrollCamera();
            } else {
                tabUpload.className = 'tab-item';
                tabCamera.className = 'tab-item active-checkin';
                uploadCont.style.display = 'none';
                cameraCont.style.display = 'flex';

                // Reset snap state and start camera
                retakeEnrollPhoto();
            }
        }

        async function startEnrollCamera() {
            stopEnrollCamera();
            const enrollVideo = document.getElementById('enroll-video');
            const msgBox = document.getElementById('enroll-msg');

            // If main webcam stream is already active with live tracks, reuse it directly without hardware collision!
            if (webcamStream && webcamStream.active && webcamStream.getVideoTracks().length > 0 && webcamStream.getVideoTracks()[0].readyState === 'live') {
                enrollVideo.srcObject = webcamStream;
                enrollVideo.setAttribute('playsinline', 'true');
                try {
                    await enrollVideo.play();
                    return;
                } catch (e) {
                    console.log("Reusing main webcamStream playback failed, trying fresh stream:", e);
                }
            }

            try {
                enrollWebcamStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: { ideal: enrollFacingMode },
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: false
                });
                enrollVideo.srcObject = enrollWebcamStream;
                enrollVideo.setAttribute('playsinline', 'true');
                await enrollVideo.play();
            } catch (err) {
                console.error("Enrollment camera start error:", err);
                msgBox.style.display = 'block';
                msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                msgBox.style.color = '#fca5a5';
                msgBox.innerHTML = `⚠️ Camera access failed (${err.name || err.message}). Please use "Upload Photo" tab above.`;
            }
        }

        function stopEnrollCamera() {
            if (enrollWebcamStream) {
                enrollWebcamStream.getTracks().forEach(track => track.stop());
                enrollWebcamStream = null;
            }
            const enrollVideo = document.getElementById('enroll-video');
            if (enrollVideo) {
                enrollVideo.srcObject = null;
            }
        }

        async function flipEnrollCamera() {
            enrollFacingMode = enrollFacingMode === 'user' ? 'environment' : 'user';
            // Stop any dedicated stream to force flip
            if (enrollWebcamStream) {
                enrollWebcamStream.getTracks().forEach(t => t.stop());
                enrollWebcamStream = null;
            }
            const enrollVideo = document.getElementById('enroll-video');
            if (enrollVideo) enrollVideo.srcObject = null;

            try {
                enrollWebcamStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: { ideal: enrollFacingMode },
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: false
                });
                enrollVideo.srcObject = enrollWebcamStream;
                enrollVideo.setAttribute('playsinline', 'true');
                await enrollVideo.play();
            } catch (err) {
                console.error("Flip camera error:", err);
            }
        }

        function snapEnrollPhoto() {
            const enrollVideo = document.getElementById('enroll-video');
            const enrollCanvas = document.getElementById('enroll-canvas');
            const snapImg = document.getElementById('enroll-snap-img');
            const videoWrapper = document.getElementById('enroll-video-wrapper');
            const camControls = document.getElementById('enroll-cam-controls');
            const snapPreview = document.getElementById('enroll-snap-preview');
            const msgBox = document.getElementById('enroll-msg');

            if (!enrollVideo) {
                return;
            }

            const w = enrollVideo.videoWidth || 640;
            const h = enrollVideo.videoHeight || 480;

            enrollCanvas.width = w;
            enrollCanvas.height = h;
            const ctx = enrollCanvas.getContext('2d');
            ctx.drawImage(enrollVideo, 0, 0, w, h);

            selectedEnrollBase64 = enrollCanvas.toDataURL('image/jpeg', 0.92);
            snapImg.src = selectedEnrollBase64;

            // Switch to snap preview
            videoWrapper.style.display = 'none';
            camControls.style.display = 'none';
            snapPreview.style.display = 'flex';

            // Show guidance message
            msgBox.style.display = 'block';
            msgBox.style.background = 'rgba(16, 185, 129, 0.12)';
            msgBox.style.border = '1px solid rgba(16, 185, 129, 0.3)';
            msgBox.style.color = '#34d399';
            msgBox.innerHTML = `📸 Photo captured! Enter your <strong>Name</strong> & <strong>Employee ID</strong>, then click <strong>"✓ Enroll Employee"</strong> below.`;

            // Auto-focus Name field if empty
            const nameInput = document.getElementById('enroll-name');
            if (!nameInput.value.trim()) {
                nameInput.focus();
            }

            stopEnrollCamera();
        }

        function retakeEnrollPhoto() {
            selectedEnrollBase64 = null;
            const videoWrapper = document.getElementById('enroll-video-wrapper');
            const camControls = document.getElementById('enroll-cam-controls');
            const snapPreview = document.getElementById('enroll-snap-preview');
            const msgBox = document.getElementById('enroll-msg');

            if (videoWrapper) videoWrapper.style.display = 'flex';
            if (camControls) camControls.style.display = 'flex';
            if (snapPreview) snapPreview.style.display = 'none';
            if (msgBox) msgBox.style.display = 'none';

            startEnrollCamera();
        }

        function handleEnrollFileSelect(e) {
            const file = e.target.files?.[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (event) => {
                selectedEnrollBase64 = event.target.result;
                document.getElementById('enroll-preview-img').src = selectedEnrollBase64;
                document.getElementById('dropzone-prompt').style.display = 'none';
                document.getElementById('dropzone-preview').style.display = 'flex';

                const msgBox = document.getElementById('enroll-msg');
                msgBox.style.display = 'block';
                msgBox.style.background = 'rgba(16, 185, 129, 0.12)';
                msgBox.style.border = '1px solid rgba(16, 185, 129, 0.3)';
                msgBox.style.color = '#34d399';
                msgBox.innerHTML = `📁 Photo selected! Enter your <strong>Name</strong> & <strong>Employee ID</strong>, then click <strong>"✓ Enroll Employee"</strong>.`;
            };
            reader.readAsDataURL(file);
        }

        // Setup dropzone drag and drop listeners
        const dropzone = document.getElementById('enroll-dropzone');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(name => {
                dropzone.addEventListener(name, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(name => {
                dropzone.addEventListener(name, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                });
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const file = dt.files?.[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        selectedEnrollBase64 = event.target.result;
                        document.getElementById('enroll-preview-img').src = selectedEnrollBase64;
                        document.getElementById('dropzone-prompt').style.display = 'none';
                        document.getElementById('dropzone-preview').style.display = 'flex';
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        async function handleEnrollSubmit(e) {
            e.preventDefault();
            const nameInput = document.getElementById('enroll-name');
            const empIdInput = document.getElementById('enroll-emp-id');
            const deptInput = document.getElementById('enroll-dept');
            const submitBtn = document.getElementById('btn-enroll-submit');
            const submitText = document.getElementById('enroll-submit-text');
            const msgBox = document.getElementById('enroll-msg');

            const name = nameInput.value.trim();
            const employee_id = empIdInput.value.trim();
            const department = deptInput.value.trim() || 'General';

            if (!selectedEnrollBase64) {
                msgBox.style.display = 'block';
                msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                msgBox.style.color = '#fca5a5';
                msgBox.innerHTML = '⚠️ Please upload or snap a photo of the employee first.';
                return;
            }

            // Set loading state
            submitBtn.disabled = true;
            submitText.innerHTML = '<span>⏳</span> Extracting Face & Indexing...';
            msgBox.style.display = 'none';

            try {
                const response = await fetch('/api/enroll', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        employee_id: employee_id,
                        department: department,
                        image_base64: selectedEnrollBase64
                    })
                });

                const data = await response.json();

                if (response.ok && data.status === 'SUCCESS') {
                    msgBox.style.display = 'block';
                    msgBox.style.background = 'rgba(16, 185, 129, 0.14)';
                    msgBox.style.border = '1px solid rgba(16, 185, 129, 0.35)';
                    msgBox.style.color = '#34d399';
                    msgBox.innerHTML = `✓ <strong>${data.name}</strong> (${data.employee_id}) enrolled successfully! Total Enrolled: <strong>${data.total_enrolled}</strong>`;

                    // Update gallery count immediately in UI
                    document.getElementById('stat-enrolled').innerText = data.total_enrolled;
                    fetchSystemStatus();

                    // Close modal after 1.4s
                    setTimeout(() => {
                        closeEnrollModalDirect();
                        if (currentSourceMode === 'LIVE_CAMERA' && !isCameraLoopActive) {
                            startLiveCapture();
                        }
                    }, 1400);
                } else {
                    const errDetail = data.detail || 'Enrollment failed. Please ensure a clear frontal face is visible.';
                    msgBox.style.display = 'block';
                    msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                    msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                    msgBox.style.color = '#fca5a5';
                    msgBox.innerHTML = `⚠️ ${errDetail}`;
                }
            } catch (err) {
                console.error('Enrollment submission error:', err);
                msgBox.style.display = 'block';
                msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                msgBox.style.color = '#fca5a5';
            } finally {
                submitBtn.disabled = false;
                submitText.innerHTML = '✓ Enroll Employee';
            }
        }

        // -------------------------------------------------------------
        // Activity Feed Filters & Rendering
        // -------------------------------------------------------------
        function setFeedFilter(filter) {
            activeFeedFilter = filter;
            document.getElementById('tab-checkin').className = 'tab-item' + (filter === 'CHECK_IN' ? ' active-checkin' : '');
            document.getElementById('tab-checkout').className = 'tab-item' + (filter === 'CHECK_OUT' ? ' active-checkout' : '');
            document.getElementById('tab-all').className = 'tab-item' + (filter === 'ALL' ? ' active-all' : '');
            renderAttendanceList();
        }

        async function fetchSystemStatus() {
            try {
                const res = await fetch('/api/status');
                const data = await res.json();
                if (data.total_enrolled !== undefined) {
                    document.getElementById('stat-enrolled').innerText = data.total_enrolled;
                }
            } catch (err) {
                console.error("Status fetch error:", err);
            }
        }

        async function fetchAttendanceData() {
            try {
                const res = await fetch('/api/attendance/recent');
                const data = await res.json();
                if (data.active_mode && data.active_mode !== currentSystemMode) {
                    currentSystemMode = data.active_mode;
                    updateModeUI(data.active_mode);
                }
                if (data.attendance_records) {
                    currentRecords = data.attendance_records;
                    renderAttendanceList();
                }
            } catch (err) {
                console.error("Attendance fetch error:", err);
            }
        }

        function formatISTTime(rec) {
            if (rec && rec.time_str) return rec.time_str;
            if (!rec || !rec.timestamp) return '--:--:--';
            try {
                const d = new Date(rec.timestamp);
                return d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
            } catch (e) {
                return rec.timestamp;
            }
        }

        function formatISTDateTime(rec) {
            if (rec && rec.date_str) return rec.date_str;
            if (!rec || !rec.timestamp) return '--:--:--';
            try {
                const d = new Date(rec.timestamp);
                return d.toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
            } catch (e) {
                return rec.timestamp;
            }
        }

        function getGroupedEmployeeRecords() {
            const map = new Map();
            for (const rec of currentRecords) {
                if (!map.has(rec.employee_id)) {
                    map.set(rec.employee_id, {
                        employee_id: rec.employee_id,
                        enrolled_photo_path: rec.enrolled_photo_path,
                        eventsMap: {}
                    });
                }
                const empGroup = map.get(rec.employee_id);
                if (!empGroup.enrolled_photo_path && rec.enrolled_photo_path) {
                    empGroup.enrolled_photo_path = rec.enrolled_photo_path;
                }
                empGroup.eventsMap[rec.event_type] = rec;
            }
            return Array.from(map.values());
        }

        function selectSubEvent(event, empId, eventType) {
            if (event) event.stopPropagation();
            selectedEmpSubEvents[empId] = eventType;
            renderAttendanceList();
            if (document.getElementById('modal-overlay').classList.contains('active') && currentModalEmpId === empId) {
                renderModalForEmployee(empId);
            }
        }

        function renderAttendanceList() {
            const list = document.getElementById('attendance-list');

            // 1. ALL FEED TAB: Grouped Employee Cards
            if (activeFeedFilter === 'ALL') {
                const groupedList = getGroupedEmployeeRecords();
                if (groupedList.length > 0) {
                    list.innerHTML = groupedList.map(emp => {
                        const empId = emp.employee_id;
                        const availableTypes = Object.keys(emp.eventsMap);

                        let activeType = selectedEmpSubEvents[empId];
                        if (!activeType || !emp.eventsMap[activeType]) {
                            activeType = emp.eventsMap['CHECK_IN'] ? 'CHECK_IN' : (emp.eventsMap['RE_ENTRY'] ? 'RE_ENTRY' : availableTypes[0]);
                            selectedEmpSubEvents[empId] = activeType;
                        }

                        const activeRec = emp.eventsMap[activeType];
                        const isCheckout = activeType === "CHECK_OUT";
                        const isReentry = activeType === "RE_ENTRY";

                        let badgeColor = "var(--accent-green)";
                        let frameLabel = "Check-In Capture";

                        if (isCheckout) {
                            badgeColor = "var(--accent-purple)";
                            frameLabel = "Check-Out Capture";
                        } else if (isReentry) {
                            badgeColor = "var(--accent-orange)";
                            frameLabel = "Re-Entry Capture";
                        }

                        const borderStyle = `1.5px solid ${badgeColor}`;

                        const buttonsHtml = availableTypes.map(type => {
                            let btnClass = "pill-btn";
                            if (type === activeType) {
                                btnClass += type === "CHECK_IN" ? " active-checkin" : (type === "RE_ENTRY" ? " active-reentry" : " active-checkout");
                            }
                            const labelText = type === "CHECK_IN" ? "CHECK-IN" : (type === "RE_ENTRY" ? "RE-ENTRY" : "CHECK-OUT");
                            return `<button class="${btnClass}" onclick="selectSubEvent(event, '${empId}', '${type}')">${labelText}</button>`;
                        }).join('');

                        return `
                            <li class="activity-card" onclick="openModalForEmployee('${empId}')" title="Tap to view details">
                                <div class="activity-card-header">
                                    <div class="emp-name" style="color: ${badgeColor};">${emp.employee_id}</div>
                                    <div class="sub-btn-group">
                                        ${buttonsHtml}
                                    </div>
                                </div>
                                <div class="dual-photos">
                                    <div class="photo-box">
                                        <img src="${activeRec ? activeRec.captured_frame_path || '' : ''}" style="border: ${borderStyle};">
                                        <span class="photo-caption" style="color: ${badgeColor};">${frameLabel}</span>
                                    </div>
                                    <div class="photo-box">
                                        <img src="${emp.enrolled_photo_path || ''}" style="border: 1.5px solid var(--accent-blue);">
                                        <span class="photo-caption" style="color: var(--accent-blue);">Official Photo</span>
                                    </div>
                                </div>
                            </li>
                        `;
                    }).join('');
                } else {
                    list.innerHTML = '<div class="empty-state">No activity records found.</div>';
                }
            }
            // 2. CHECK-IN / CHECK-OUT FEED TABS: Individual Event Cards
            else {
                let filtered = currentRecords;
                if (activeFeedFilter === 'CHECK_IN') {
                    filtered = currentRecords.filter(r => r.event_type === 'CHECK_IN' || r.event_type === 'RE_ENTRY');
                } else if (activeFeedFilter === 'CHECK_OUT') {
                    filtered = currentRecords.filter(r => r.event_type === 'CHECK_OUT');
                }

                if (filtered.length > 0) {
                    list.innerHTML = filtered.map(rec => {
                        const isCheckout = rec.event_type === "CHECK_OUT";
                        const isReentry = rec.event_type === "RE_ENTRY";

                        let badgeColor = "var(--accent-green)";
                        let badgeText = "CHECK-IN";
                        let frameLabel = "Check-In Capture";

                        if (isCheckout) {
                            badgeColor = "var(--accent-purple)";
                            badgeText = "CHECK-OUT";
                            frameLabel = "Check-Out Capture";
                        } else if (isReentry) {
                            badgeColor = "var(--accent-orange)";
                            badgeText = "RE-ENTRY";
                            frameLabel = "Re-Entry Capture";
                        }

                        const borderStyle = `1.5px solid ${badgeColor}`;

                        return `
                            <li class="activity-card" onclick="openModalByRecordId(${rec.id})" title="Tap to view details">
                                <div class="activity-card-header">
                                    <div class="emp-name" style="color: ${badgeColor};">${rec.employee_id}</div>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <span class="badge-tag" style="background: rgba(255,255,255,0.04); color: ${badgeColor}; border-color: ${badgeColor};">${badgeText}</span>
                                        <div style="font-size: 0.7rem; color: var(--text-muted); font-weight: 500;">${formatISTTime(rec)}</div>
                                    </div>
                                </div>
                                <div class="dual-photos">
                                    <div class="photo-box">
                                        <img src="${rec.captured_frame_path || ''}" style="border: ${borderStyle};">
                                        <span class="photo-caption" style="color: ${badgeColor};">${frameLabel}</span>
                                    </div>
                                    <div class="photo-box">
                                        <img src="${rec.enrolled_photo_path || ''}" style="border: 1.5px solid var(--accent-blue);">
                                        <span class="photo-caption" style="color: var(--accent-blue);">Official Photo</span>
                                    </div>
                                </div>
                            </li>
                        `;
                    }).join('');
                } else {
                    list.innerHTML = `<div class="empty-state">No ${activeFeedFilter.toLowerCase()} records.</div>`;
                }
            }
        }

        // -------------------------------------------------------------
        // Modal Lightbox
        // -------------------------------------------------------------
        function openModalForEmployee(empId) {
            currentModalEmpId = empId;
            renderModalForEmployee(empId);
            document.getElementById('modal-overlay').classList.add('active');
        }

        function renderModalForEmployee(empId) {
            const groupedList = getGroupedEmployeeRecords();
            const empGroup = groupedList.find(e => e.employee_id === empId);
            if (!empGroup) return;

            const availableTypes = Object.keys(empGroup.eventsMap);
            let activeType = selectedEmpSubEvents[empId] || availableTypes[0];
            if (!empGroup.eventsMap[activeType]) activeType = availableTypes[0];

            const activeRec = empGroup.eventsMap[activeType];
            const isCheckout = activeType === "CHECK_OUT";
            const isReentry = activeType === "RE_ENTRY";

            let badgeColor = "var(--accent-green)";
            let badgeText = "VERIFIED CHECK-IN";
            let frameLabel = "Live Check-In Capture";

            if (isCheckout) {
                badgeColor = "var(--accent-purple)";
                badgeText = "VERIFIED CHECK-OUT";
                frameLabel = "Live Check-Out Capture";
            } else if (isReentry) {
                badgeColor = "var(--accent-orange)";
                badgeText = "VERIFIED RE-ENTRY";
                frameLabel = "Live Re-Entry Capture";
            }

            const empTitle = document.getElementById('modal-emp-name');
            empTitle.innerText = empGroup.employee_id;
            empTitle.style.color = badgeColor;

            const modalBtns = document.getElementById('modal-sub-buttons');
            modalBtns.innerHTML = availableTypes.map(type => {
                let btnClass = "pill-btn";
                if (type === activeType) {
                    btnClass += type === "CHECK_IN" ? " active-checkin" : (type === "RE_ENTRY" ? " active-reentry" : " active-checkout");
                }
                const labelText = type === "CHECK_IN" ? "CHECK-IN" : (type === "RE_ENTRY" ? "RE-ENTRY" : "CHECK-OUT");
                return `<button class="${btnClass}" onclick="selectSubEvent(event, '${empId}', '${type}')">${labelText}</button>`;
            }).join('');

            const capImg = document.getElementById('modal-img-captured');
            capImg.src = activeRec ? activeRec.captured_frame_path || '' : '';
            capImg.style.border = `2px solid ${badgeColor}`;

            const capLabel = document.getElementById('modal-cap-label');
            capLabel.innerText = frameLabel;
            capLabel.style.color = badgeColor;

            document.getElementById('modal-img-enrolled').src = empGroup.enrolled_photo_path || '';
            document.getElementById('modal-time-label').innerText = `${activeType.replace('_', '-')} Time (IST): `;
            document.getElementById('modal-time').innerText = activeRec ? formatISTDateTime(activeRec) : '--:--:--';

            const statusBadge = document.getElementById('modal-status-badge');
            statusBadge.innerText = badgeText;
            statusBadge.style.color = badgeColor;

            document.getElementById('modal-card').style.borderColor = badgeColor;
        }

        function openModalByRecordId(id) {
            const rec = currentRecords.find(r => r.id === id);
            if (!rec) return;
            const isCheckout = rec.event_type === "CHECK_OUT";
            const isReentry = rec.event_type === "RE_ENTRY";

            let badgeColor = "var(--accent-green)";
            let badgeText = "VERIFIED CHECK-IN";
            let frameLabel = "Live Check-In Capture";

            if (isCheckout) {
                badgeColor = "var(--accent-purple)";
                badgeText = "VERIFIED CHECK-OUT";
                frameLabel = "Live Check-Out Capture";
            } else if (isReentry) {
                badgeColor = "var(--accent-orange)";
                badgeText = "VERIFIED RE-ENTRY";
                frameLabel = "Live Re-Entry Capture";
            }

            const empTitle = document.getElementById('modal-emp-name');
            empTitle.innerText = rec.employee_id;
            empTitle.style.color = badgeColor;

            document.getElementById('modal-sub-buttons').innerHTML = '';

            const capImg = document.getElementById('modal-img-captured');
            capImg.src = rec.captured_frame_path || '';
            capImg.style.border = `2px solid ${badgeColor}`;

            const capLabel = document.getElementById('modal-cap-label');
            capLabel.innerText = frameLabel;
            capLabel.style.color = badgeColor;

            document.getElementById('modal-img-enrolled').src = rec.enrolled_photo_path || '';
            document.getElementById('modal-time-label').innerText = isCheckout ? "Check-Out Time (IST): " : "Check-In Time (IST): ";
            document.getElementById('modal-time').innerText = formatISTDateTime(rec);

            const statusBadge = document.getElementById('modal-status-badge');
            statusBadge.innerText = badgeText;
            statusBadge.style.color = badgeColor;

            document.getElementById('modal-card').style.borderColor = badgeColor;
            document.getElementById('modal-overlay').classList.add('active');
        }

        function closeModalDirect() {
            document.getElementById('modal-overlay').classList.remove('active');
            currentModalEmpId = null;
        }

        function closeModal(event) {
            if (event.target.id === 'modal-overlay') {
                closeModalDirect();
            }
        }

        // -------------------------------------------------------------
        // Registered Employees Directory & Removal
        // -------------------------------------------------------------
        let allEnrolledEmployees = [];

        async function openDirectoryModal() {
            const listElem = document.getElementById('dir-employees-list');
            listElem.innerHTML = '<div class="empty-state">Loading registered employees...</div>';
            document.getElementById('dir-search-input').value = '';

            const msgBox = document.getElementById('dir-msg');
            if (msgBox) msgBox.style.display = 'none';

            document.getElementById('dir-modal-overlay').classList.add('active');

            try {
                const res = await fetch('/api/employees');
                const data = await res.json();
                if (data.status === 'SUCCESS' && data.employees) {
                    allEnrolledEmployees = data.employees;
                    document.getElementById('dir-count-badge').innerText = `${allEnrolledEmployees.length} Enrolled`;
                    document.getElementById('stat-enrolled').innerText = allEnrolledEmployees.length;
                    renderDirectoryList(allEnrolledEmployees);
                } else {
                    listElem.innerHTML = '<div class="empty-state">No registered employees found.</div>';
                }
            } catch (err) {
                console.error("Failed to load employees directory:", err);
                listElem.innerHTML = `<div class="empty-state" style="color: var(--accent-red);">Failed to load directory: ${err.message}</div>`;
            }
        }

        function closeDirectoryModalDirect() {
            document.getElementById('dir-modal-overlay').classList.remove('active');
        }

        function closeDirectoryModal(event) {
            if (event.target.id === 'dir-modal-overlay') {
                closeDirectoryModalDirect();
            }
        }

        function openEnrollFromDirectory() {
            closeDirectoryModalDirect();
            openEnrollModal();
        }

        function filterDirectoryList() {
            const query = (document.getElementById('dir-search-input').value || '').trim().toLowerCase();
            if (!query) {
                renderDirectoryList(allEnrolledEmployees);
                return;
            }
            const filtered = allEnrolledEmployees.filter(emp => {
                const name = (emp.name || '').toLowerCase();
                const id = (emp.employee_id || '').toLowerCase();
                return name.includes(query) || id.includes(query);
            });
            renderDirectoryList(filtered, query);
        }

        function renderDirectoryList(list, query = '') {
            const listElem = document.getElementById('dir-employees-list');
            if (!list || list.length === 0) {
                listElem.innerHTML = query
                    ? `<div class="empty-state">No employees matching "${query}".</div>`
                    : '<div class="empty-state">No registered employees found.</div>';
                return;
            }

            listElem.innerHTML = list.map(emp => {
                const photoSrc = emp.photo_url || '';
                const empName = emp.name || 'Unnamed';
                const empId = emp.employee_id || '';
                const safeName = empName.replace(/'/g, "\\'");
                const safeId = empId.replace(/'/g, "\\'");

                return `
                    <div class="dir-employee-card" id="dir-card-${empId}">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <img src="${photoSrc}" alt="${empName}" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; background: #000; border: 1.5px solid var(--border-subtle);" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\\'http://www.w3.org/2000/svg\\' width=\\'44\\' height=\\'44\\' viewBox=\\'0 0 44 44\\'><rect width=\\'44\\' height=\\'44\\' fill=\\'%23222\\'/><text x=\\'50%25\\' y=\\'55%25\\' fill=\\'%23666\\' font-size=\\'18\\' font-family=\\'sans-serif\\' text-anchor=\\'middle\\' dominant-baseline=\\'middle\\'>👤</text></svg>'">
                            <div style="display: flex; flex-direction: column; gap: 2px;">
                                <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-primary);">${empName}</div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="badge-tag" style="background: rgba(255,255,255,0.04); color: var(--accent-blue); border-color: rgba(59,130,246,0.3); font-size: 0.65rem; padding: 2px 7px;">${empId}</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="delete-btn" onclick="removeEmployee('${safeId}', '${safeName}')" title="Remove ${empName}">
                            <span>🗑️</span> Remove
                        </button>
                    </div>
                `;
            }).join('');
        }

        async function removeEmployee(empId, empName) {
            const confirmed = confirm(`Are you sure you want to remove "${empName}" (${empId}) from the registered gallery?`);
            if (!confirmed) return;

            const msgBox = document.getElementById('dir-msg');
            try {
                const res = await fetch(`/api/employees/${encodeURIComponent(empId)}`, {
                    method: 'DELETE'
                });
                const data = await res.json();

                if (res.ok && data.status === 'SUCCESS') {
                    // Remove from in-memory list
                    allEnrolledEmployees = allEnrolledEmployees.filter(e => e.employee_id !== empId);

                    // Update badges and stat
                    document.getElementById('dir-count-badge').innerText = `${allEnrolledEmployees.length} Enrolled`;
                    document.getElementById('stat-enrolled').innerText = allEnrolledEmployees.length;

                    // Re-render filtered list
                    filterDirectoryList();

                    // Show success toast
                    if (msgBox) {
                        msgBox.style.display = 'block';
                        msgBox.style.background = 'rgba(16, 185, 129, 0.14)';
                        msgBox.style.border = '1px solid rgba(16, 185, 129, 0.35)';
                        msgBox.style.color = '#34d399';
                        msgBox.innerHTML = `✓ <strong>${empName}</strong> (${empId}) has been removed from the gallery.`;
                        setTimeout(() => { if (msgBox) msgBox.style.display = 'none'; }, 3500);
                    }
                } else {
                    const errDetail = data.detail || 'Failed to remove employee.';
                    if (msgBox) {
                        msgBox.style.display = 'block';
                        msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                        msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                        msgBox.style.color = '#fca5a5';
                        msgBox.innerHTML = `⚠️ ${errDetail}`;
                    }
                }
            } catch (err) {
                console.error("Removal error:", err);
                if (msgBox) {
                    msgBox.style.display = 'block';
                    msgBox.style.background = 'rgba(239, 68, 68, 0.12)';
                    msgBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                    msgBox.style.color = '#fca5a5';
                    msgBox.innerHTML = `⚠️ Connection error: ${err.message}`;
                }
            }
        }

        // -------------------------------------------------------------
        // Initialization on Load
        // -------------------------------------------------------------
        window.addEventListener('DOMContentLoaded', () => {
            fetchSystemStatus();
            fetchAttendanceData();
            setInterval(fetchAttendanceData, 1000);

            // Default to Live Camera Mode overlay ready to open
            setVideoSourceMode('LIVE_CAMERA');
        });
    </script>
</body>

</html>